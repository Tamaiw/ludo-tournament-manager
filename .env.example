# Application environment.
APP_ENV=production

# Listen port inside the container. Caddy reverses-proxy to this port.
PORT=8080

# Whether session/CSRF cookies require Secure (HTTPS). Must be true in production.
COOKIE_SECURE=true

# 32-byte random key. Used for both session ID derivation and CSRF HMAC.
# Generate with: head -c 32 /dev/urandom | base64
SESSION_KEY=replace-me-with-32-bytes-of-randomness==

# Database file path inside the container. Bind-mounted to ./data via docker-compose.
DB_PATH=/data/ludo.db

# SMTP credentials (Resend in prod; Mailpit in dev — see docker-compose.dev.yml).
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=replace-me
SMTP_FROM=Ludo <noreply@example.com>

# Public URL — used to build invite / password-reset links.
PUBLIC_URL=https://ludo.example.com